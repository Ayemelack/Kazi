{
  "name": "@kazi/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Contracts shared by the Kazi app and API (pure TypeScript, no runtime dependencies)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
