# Copy this file to .env and fill in real values.
# .env is git-ignored and never committed.

# Runtime mode. Servers run with NODE_ENV=production, set in the service
# environment (docs/DEPLOYMENT.md §3), not here. On your own machine uncomment
# the next line: with any other value, or none, the API refuses to start
# unless an email sender for password reset codes is configured (KZ-06).
#NODE_ENV=development

# Signs session tokens. At least 32 random bytes; generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# With NODE_ENV=production the server refuses to start if it is missing,
# shorter than 32 bytes or still this example value (KZ-29).
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (default 4000).
PORT=4000

# Comma-separated allowlist of browser origins permitted to call the API.
# CORS is DENIED by default (the mobile app does not need it). Set the exact
# origins of any web dashboard you run here. The literal "*" re-enables the
# open behavior.
#CORS_ORIGIN=https://dashboard.example.com

# Firebase Cloud Messaging service account for push notifications.
# Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT      base64-encoded service-account JSON
#   GOOGLE_APPLICATION_CREDENTIALS  path to a service-account JSON file
# When unset, push notifications are disabled and /notifications/send returns
# 503 PUSH_NOT_CONFIGURED.
#FIREBASE_SERVICE_ACCOUNT=
#GOOGLE_APPLICATION_CREDENTIALS=

# Password reset codes (KZ-06) are emailed through a provider's HTTPS API.
# Required unless NODE_ENV is development or test, where codes are printed to
# this server's console instead. Never commit a real key.
#   EMAIL_PROVIDER   brevo | postmark | http (a JSON relay with a bearer token)
#   EMAIL_API_KEY    Brevo API key, Postmark server token, or the relay's token
#   EMAIL_FROM       sender address, verified with the provider (SPF/DKIM)
#   EMAIL_FROM_NAME  display name; letters, digits, spaces, . ' & - (default Kazi)
#   EMAIL_API_URL    https:// endpoint; required for http, optional otherwise
#EMAIL_PROVIDER=brevo
#EMAIL_API_KEY=
#EMAIL_FROM=no-reply@yourdomain.example
#EMAIL_FROM_NAME=Kazi
#EMAIL_API_URL=

# Development only: forgot-password also returns the code in its response, so
# a debug build of the app can prefill it. Works only with NODE_ENV=development
# or test; with any other NODE_ENV the API refuses to start while it is set.
#ALLOW_DEV_RESET_CODE=1
