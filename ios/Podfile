# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase (KZ-02). The Firebase iOS SDK pods need frameworks.
# RNFB 26 resolves Firebase through Swift Package Manager by default, which
# only works with dynamic frameworks and gives each RNFB pod its own private
# FirebaseCore. Kazi uses CocoaPods with static frameworks instead (RNFB's
# supported alternative, see node_modules/@react-native-firebase/app/README.md):
# one FirebaseCore shared by RNFB and AppDelegate's FirebaseApp.configure(),
# and no dynamic-framework launch cost. Both flags must be set before any
# target block. The New Architecture (required by RNFB 26) is RN 0.87's
# default and stays on.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'Kazi' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
